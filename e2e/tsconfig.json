{
  /* Same rules as the app, plus Node types: the specs run in Playwright's
     runner, and they read the catalog and message JSON off disk. */
  "extends": "../tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  /* Drop the app project's exclude, which is about src/ and not about this. */
  "exclude": []
}
