{
  /* Same rules as the app, plus Node types: tests may read files from disk. */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test"],
  /* Drop the app project's exclude, which is exactly what this one includes. */
  "exclude": []
}
